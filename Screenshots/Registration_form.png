  :where(.puik-root) .text-tertiary { color: var(--color-text-tertiary); }
  @media (hover: hover) {
  :where(.puik-root) .hover\:text-primary:hover { color: var(--color-text-p=
rimary); }
  :where(.puik-root) .hover\:text-secondary:hover { color: var(--color-text=
-secondary); }
  :where(.puik-root) .hover\:text-tertiary:hover { color: var(--color-text-=
tertiary); }
}
  :where(.puik-root) .text-info { color: var(--color-text-info); }
  :where(.puik-root) .text-danger { color: var(--color-text-danger); }
  :where(.puik-root) .text-warning { color: var(--color-text-warning); }
  :where(.puik-root) .text-discovery { color: var(--color-text-discovery); =
}
  :where(.puik-root) .rounded-2xs { border-radius: var(--radius-2xs); }
  :where(.puik-root) .bg-surface { background-color: var(--color-surface); =
}
  :where(.puik-root) .bg-surface-elevated { background-color: var(--color-s=
urface-elevated); }
  :where(.puik-root) .bg-surface-elevated-secondary { background-color: var=
(--color-surface-elevated-secondary); }
}

[inert] { pointer-events: none; cursor: inherit; }

[inert], [inert] * { user-select: none; }

