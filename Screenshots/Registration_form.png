R_mOW_fullscreen-popover-thread) { z-index: 0; transform-origin: center bot=
tom; animation: sR_mOW_popover-thread-enter .3s var(--spring-fast) both; }

.sR_mOW_fullscreen-popover-thread-closing-transition::view-transition-old(s=
R_mOW_fullscreen-popover-thread) { z-index: 0; transform-origin: center bot=
tom; animation: sR_mOW_popover-thread-exit .3s var(--spring-fast) both; }

@keyframes sR_mOW_popover-thread-enter {=20
  0% { opacity: 0; transform: scale(0.98); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes sR_mOW_popover-thread-exit {=20
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.98); }
}

.A_HxFq_root { display: grid; }

.A_HxFq_toggleControl, .A_HxFq_showLessLabel { display: none; }

