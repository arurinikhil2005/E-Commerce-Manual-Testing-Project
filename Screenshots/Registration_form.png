px; border-radius: 0.375rem; align-items: center; gap: 0.25rem; margin-top:=
 0.5rem; padding: 0.125rem 0px; font-family: inherit; font-size: 0.875rem; =
font-weight: 500; line-height: 1.25rem; display: flex; }

