fill-opacity: 1; stroke-width: 1px; stroke-linecap: butt; stroke-linejoin: =
miter; stroke-miterlimit: 4; stroke-dasharray: none; stroke-dashoffset: 0; =
stroke-opacity: 1; height: inherit; width: 100%; display: block; position: =
absolute; }

